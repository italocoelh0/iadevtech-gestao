# Banco MySQL - mantenha somente no servidor.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?connection_limit=3&pool_timeout=10"

# Auth.js / NextAuth - gere um segredo forte e único para produção.
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
AUTH_TRUST_HOST="true"

# URL pública. Não é segredo.
NEXT_PUBLIC_APP_NAME="Gestão de Empresa"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed inicial (use apenas no ambiente administrativo/local e remova depois).
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME"

# Observabilidade
LOG_LEVEL="info"
